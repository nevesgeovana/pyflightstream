# Local-only material: manuals, research geometry (hard invariants 1 and 5)
_private/

# Licensed or binary documents never enter Git
*.pdf
*.ipynb

# Python build and cache artifacts
__pycache__/
*.pyc
build/
dist/
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Docs build output (ProperDocs)
site/

# Local run scratch, one root for every tier (runs/probes, runs/physics,
# runs/drift, runs/fsi, campaign workspaces); the committed evidence is
# the reports/ tree, never the scratch. Convention recorded at HND-035
# session close; the earlier per-tier roots (probe_runs/, physics_runs/,
# drift_runs*/, fsi_runs/) moved under runs/ the same day.
runs/

# LaTeX build artifacts of the beamer guide; the built pdf never
# enters Git (repository guard), only guide/*.tex is committed
guide/*.pdf
guide/*.aux
guide/*.log
guide/*.nav
guide/*.out
guide/*.snm
guide/*.toc
guide/*.fls
guide/*.fdb_latexmk
guide/*.synctex.gz
guide/*.vrb

# Role-review push-gate attestation (local session state, never versioned)
.claude/.role_review_attestation.json

# Local machine configuration (absolute paths: incident ledger, plan checker)
.claude/settings.local.json

# Reviewer worktrees. The role-review skill parks a mutating pass in a full
# second copy of the repository under here, and `git worktree remove` fails on
# Windows while a handle is open, so an abandoned copy outlives the review.
#
# Committed on 2026-08-12 rather than left to `.git/info/exclude`, where it had
# been living on one machine. That was not a tidiness point: the shipped
# surface scan wired the same night builds its inventory from `git ls-files`
# PLUS `--others --exclude-standard`, and turns any path it cannot read into a
# refusal rather than a skip. A fresh clone that spawned one reviewer worktree
# would therefore see tier 1 fail with a message about coverage holes naming a
# scratch directory, and the cause would read as a checker defect.
# `tests/test_env_contract.py` already excludes this tree for the neighbouring
# reason, so the local-only exclude was the last place this was not written
# down.
.claude/worktrees/

# Coverage data and reports (NFR-16). The measurement is a local
# artifact; the FLOOR it is checked against is versioned, in
# pyproject.toml's [tool.coverage.report].
.coverage
.coverage.*
coverage.xml
htmlcov/
